{
  "name": "atlasone-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/lib/tracing.ts src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/lib/tracing.js dist/index.js",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "dev:ldap": "node ../infra/ldap/dev-server.mjs",
    "dev:mongo": "node scripts/dev-mongo.mjs",
    "verify:integration": "tsx scripts/verify-integration.ts"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@prisma/client": "^5.22.0",
    "bullmq": "^6.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^7.2.1",
    "mongoose": "^8.8.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.1.0",
    "jest": "^30.5.2",
    "ldapjs": "^3.0.7",
    "mongodb-memory-server": "^10.1.2",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ]
  }
}
