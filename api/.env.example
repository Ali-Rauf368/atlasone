PORT=4000
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlasone
MONGO_URL=mongodb://localhost:27017/atlasone
JWT_SECRET=change-me
INGEST_API_KEY=nifi-dev-key
# Local OpenLDAP. For Google Workspace Secure LDAP use:
#   LDAP_URL=ldaps://ldap.google.com:636, LDAP_BASE_DN=dc=yourdomain,dc=com,
#   LDAP_TLS_CERT / LDAP_TLS_KEY = paths to the client cert from Admin console
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=atlasone,dc=dev
LDAP_BIND_DN=cn=admin,dc=atlasone,dc=dev
LDAP_BIND_PASSWORD=admin
LDAP_TLS_CERT=
LDAP_TLS_KEY=
REDIS_URL=redis://localhost:6379
# Set to enable tracing, e.g. http://localhost:4318/v1/traces (Jaeger)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
LDAP_REGION_ATTR=ou
LDAP_COMPANY_ATTR=departmentNumber
# Comma-separated allowed origins in production
CORS_ORIGIN=
# Login attempts per IP per 15 min (raise for automated test runs)
LOGIN_RATE_LIMIT=20
